#!/usr/bin/env bash
set -e

if [ $# -lt 1 ] || [ $# -gt 3 ]; then
  echo "Usage:"
  echo "  $0 <input-file>"
  echo "  $0 <input-file> [vampire|twee] [krympa-binary]"
  echo "  $0 [vampire|twee] <input-file> [krympa-binary]"
  exit 1
fi

INPUT_PROVER="vampire"
KRYMPA_BINARY="./krympa"

is_prover() {
  [ "$1" = "vampire" ] || [ "$1" = "twee" ]
}

ARGS=("$@")
POS=0

# Optional leading prover: ./run_one twee <input> [binary]
if is_prover "${ARGS[0]}"; then
  INPUT_PROVER="${ARGS[0]}"
  POS=1
fi

if [ $POS -ge $# ]; then
  echo "Error: missing input file."
  exit 1
fi

INPUT="${ARGS[$POS]}"
POS=$((POS + 1))

# Remaining args can be prover and/or binary in any order.
while [ $POS -lt $# ]; do
  ARG="${ARGS[$POS]}"
  if is_prover "$ARG"; then
    INPUT_PROVER="$ARG"
  else
    KRYMPA_BINARY="$ARG"
  fi
  POS=$((POS + 1))
done

cd ../rust || {
  echo "Error: could not cd into ../rust"
  exit 1
}

if [ ! -x "$KRYMPA_BINARY" ]; then
  echo "Error: binary '$KRYMPA_BINARY' not found or not executable."
  exit 1
fi

if [ "$INPUT_PROVER" = "vampire" ]; then
  "$KRYMPA_BINARY" run_vampire "$INPUT"
else
  "$KRYMPA_BINARY" run_twee "$INPUT"
fi
"$KRYMPA_BINARY" collect "$INPUT" "$INPUT_PROVER"
"$KRYMPA_BINARY" minimize "$INPUT" "$INPUT_PROVER"
