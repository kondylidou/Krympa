#!/usr/bin/env bash
set -e

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "Usage: $0 <input-file> [krympa-binary]"
  exit 1
fi

INPUT="$1"
KRYMPA_BINARY="${2:-./krympa}"

cd ../rust || {
  echo "Error: could not cd into ../rust"
  exit 1
}

if [ ! -x "$KRYMPA_BINARY" ]; then
  echo "Error: binary '$KRYMPA_BINARY' not found or not executable."
  exit 1
fi

"$KRYMPA_BINARY" run_vampire "$INPUT"
"$KRYMPA_BINARY" collect "$INPUT"
"$KRYMPA_BINARY" shorten "$INPUT"
"$KRYMPA_BINARY" minimize "$INPUT"
