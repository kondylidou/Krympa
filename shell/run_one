#!/usr/bin/env bash
set -e

if [ $# -lt 1 ] || [ $# -gt 3 ]; then
  echo "Usage: $0 <input-file> [prover] [krympa-binary]"
  echo "   or: $0 <prover> <input-file> [krympa-binary]"
  echo "  prover: vampire|iprover (default: vampire)"
  exit 1
fi

PROVER="vampire"
KRYMPA_BINARY="./krympa"
INPUT="$1"

if [ "$1" = "vampire" ] || [ "$1" = "iprover" ]; then
  if [ $# -lt 2 ]; then
    echo "Error: missing input file."
    exit 1
  fi
  PROVER="$1"
  INPUT="$2"
  KRYMPA_BINARY="${3:-./krympa}"
elif [ $# -ge 2 ]; then
  if [ "$2" = "vampire" ] || [ "$2" = "iprover" ]; then
    PROVER="$2"
    KRYMPA_BINARY="${3:-./krympa}"
  else
    # backward-compatible: second arg as binary path
    KRYMPA_BINARY="$2"
  fi
fi

cd ../rust || {
  echo "Error: could not cd into ../rust"
  exit 1
}

if [ ! -x "$KRYMPA_BINARY" ]; then
  echo "Error: binary '$KRYMPA_BINARY' not found or not executable."
  exit 1
fi

export KRYMPA_ATP="$PROVER"

"$KRYMPA_BINARY" run_atp "$INPUT" "$PROVER"
"$KRYMPA_BINARY" collect "$INPUT"
"$KRYMPA_BINARY" shorten "$INPUT"
"$KRYMPA_BINARY" minimize "$INPUT"
