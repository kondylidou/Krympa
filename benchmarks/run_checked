#!/usr/bin/env bash
# Run Krympa on one problem and check the resulting proof in Lean.
#
# Usage: ./run_checked [--direct] [--term-size] [--refine] <input-file>
#
#   The options are passed on to krympa.
#
# The proof is checked in Lean, then its avoidable steps are removed and the
# shorter proof is checked as well.

FLAGS=()
INPUT=""
for arg in "$@"; do
  case "$arg" in
    --direct|--term-size|--refine) FLAGS+=("$arg") ;;
    -*) echo "Unknown option: $arg"; exit 1 ;;
    *) INPUT="$arg" ;;
  esac
done
if [ -z "$INPUT" ] || [ ! -f "$INPUT" ]; then
  echo "Usage: $0 [--direct] [--term-size] [--refine] <input-file>"
  exit 1
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
INPUT="$(cd "$(dirname "$INPUT")" && pwd)/$(basename "$INPUT")"
NAME="$(basename "$INPUT" .p)"
PROOF="$ROOT/output/proof_$NAME.out"

cd "$ROOT" || exit 1
if [ ! -x ./krympa ]; then
  echo "Error: krympa not found. Run ./build.sh first."
  exit 1
fi

echo "== Krympa proof: $PROOF"
./krympa "${FLAGS[@]}" --no-compress --lean "$INPUT"
case $? in
  0) STATUS=0 ;;
  *) [ -f "$PROOF" ] || exit 1; STATUS=1 ;;
esac

COMPRESSED="${PROOF%.out}_compressed.out"
echo
echo "== After removing avoidable steps: $COMPRESSED"
./krympa compress "$PROOF" && ./krympa lean "$COMPRESSED" || STATUS=1
exit $STATUS
